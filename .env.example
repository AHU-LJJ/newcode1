# OpenAI-compatible Chat Completions endpoint; the code appends /chat/completions.
# Copy to .env only if you do not already have one. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_MODEL=your-model-name

# Optional, for --embedding-backend api. Empty values reuse the chat API credentials.
# Embedding model is selected by --embedding-model (default: BAAI/bge-m3).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Optional judge credentials; empty values reuse the chat API credentials.
# Judge model defaults to Pro/deepseek-ai/DeepSeek-V3.2 in evaluate_locomo.
JUDGE_API_KEY=
JUDGE_BASE_URL=
